<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的云备份及设备迁移均不携带运行时凭据。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="self_hosted_credentials.xml" />
        <exclude domain="database" path="app-database" />
        <exclude domain="database" path="app-database-wal" />
        <exclude domain="database" path="app-database-shm" />
        <exclude domain="database" path="app-database-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="self_hosted_credentials.xml" />
        <exclude domain="database" path="app-database" />
        <exclude domain="database" path="app-database-wal" />
        <exclude domain="database" path="app-database-shm" />
        <exclude domain="database" path="app-database-journal" />
    </device-transfer>
</data-extraction-rules>
